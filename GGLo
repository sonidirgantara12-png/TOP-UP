            className="w-full sm:w-auto px-8 py-4 bg-green-500 hover:bg-green-400 text-black transition-all rounded-2xl font-black text-lg shadow-xl shadow-green-500/30 transform hover:-translate-y-0.5 active:translate-y-0"
          >
            BELI SEKARANG 🔥
          </button>
          <button 
            onClick={() => scrollToSection('catalog-section')}
