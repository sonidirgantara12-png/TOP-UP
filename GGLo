              <div ref={chatEndRef} />
            </div>
            <form onSubmit={handleChatSubmit} className="p-3 bg-zinc-900 border-t border-zinc-800 flex gap-2">
              <input 
                type="text" 
                placeholder="Ketik pesan..." 
                className="flex-grow bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-2 text-sm outline-none focus:border-green-500 transition"
                value={chatInput}
                onChange={(e) => setChatInput(e.target.value)}
              />
              <button type="submit" className="bg-green-500 text-black p-2.5 rounded-xl hover:bg-green-400 transition">
                <Send className="w-4 h-4" />
              </button>
            </form>
          </div>
        )}
        <button 
          onClick={() => setBotOpen(!botOpen)}
          className={`w-16 h-16 bg-green-500 rounded-full flex items-center justify-center shadow-lg shadow-green-500/30 text-black hover:bg-green-400 transition-all transform hover:scale-105 active:scale-95 ${botOpen ? 'rotate-90' : 'rotate-0'}`}
        >
          {botOpen ? <X className="w-8 h-8" /> : <MessageSquare className="w-8 h-8" />}
        </button>
      </div>

      {/* 3. Invoice / Checkout Modal */}
      {invoiceModalOpen && activeInvoice && (
        <div className="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-fade-in">
          <div className="bg-zinc-900 border border-zinc-800 rounded-3xl w-full max-w-md overflow-hidden shadow-2xl relative max-h-[95vh] flex flex-col">
            
            {/* Header */}
            <div className="p-5 border-b border-zinc-800 flex justify-between items-center bg-zinc-950">
              <h3 className="font-bold text-lg">Detail Pembayaran</h3>
              <button onClick={() => setInvoiceModalOpen(false)} className="text-zinc-400 hover:text-white">
                <X className="w-5 h-5" />
              </button>
            </div>

            {/* Scrollable Content */}
            <div className="p-6 overflow-y-auto custom-scrollbar flex-grow">
              
              {/* Status Header */}
              {invoiceStatus === 'PENDING' && (
                <div className="text-center mb-6">
                  <p className="text-sm text-zinc-400 mb-2">Selesaikan pembayaran dalam</p>
                  <p className="text-3xl font-black text-red-500 tracking-wider mb-2">{formatTime(paymentTimer)}</p>
                  <p className="text-xs text-zinc-500">ID: <span className="font-mono text-zinc-300">{activeInvoice.id}</span></p>
                </div>
              )}
              {invoiceStatus === 'PAID' && (
                <div className="text-center mb-6 text-green-400">
                  <CheckCircle2 className="w-16 h-16 mx-auto mb-2" />
                  <p className="text-xl font-bold">Pembayaran Diterima</p>
                  <p className="text-sm text-zinc-400">Sedang memvalidasi...</p>
                </div>
              )}
              {invoiceStatus === 'PROCESSING' && (
                <div className="text-center mb-6 text-blue-400">
                  <RefreshCw className="w-16 h-16 mx-auto mb-2 animate-spin" />
                  <p className="text-xl font-bold">Memproses Rubox</p>
                  <p className="text-sm text-zinc-400">Mengirim ke {activeInvoice.username}...</p>
                </div>
              )}
              {invoiceStatus === 'FAILED' && (
                <div className="text-center mb-6 text-red-500">
                  <XCircle className="w-16 h-16 mx-auto mb-2" />
                  <p className="text-xl font-bold">Transaksi Gagal</p>
                  <p className="text-sm text-zinc-400">Terjadi kesalahan atau pembayaran dibatalkan.</p>
                </div>
              )}

              {/* Payment Info Box */}
              {invoiceStatus === 'PENDING' && (
                <div className="bg-zinc-950 border border-zinc-800 rounded-2xl p-5 mb-6">
                  <div className="flex justify-between items-center mb-4 pb-4 border-b border-zinc-800">
                    <span className="text-sm text-zinc-400">Metode</span>
                    <span className="font-bold">{activeInvoice.payment}</span>
                  </div>

                  {activeInvoice.paymentId === 'qris' ? (
                    <div className="text-center">
                      <div className="bg-white p-4 rounded-xl inline-block mb-3">
                        {/* Fake QR Code */}
                        <img src={`https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=${activeInvoice.id}-${activeInvoice.total}`} alt="QRIS" className="w-32 h-32" />
                      </div>
                      <p className="text-xs text-zinc-400">Scan QRIS menggunakan aplikasi E-Wallet / M-Banking Anda</p>
                    </div>
                  ) : (
                    <div className="space-y-4">
                      <div>
                        <p className="text-xs text-zinc-500 mb-1">Nomor Rekening / Virtual Account</p>
                        <div className="flex justify-between items-center bg-zinc-900 px-4 py-3 rounded-xl border border-zinc-800">
                          <span className="font-mono font-bold text-lg tracking-wider">{activeInvoice.accountNo}</span>
                          <button onClick={() => copyToClipboard(activeInvoice.accountNo)} className="text-green-400 hover:text-green-300">
                            {isCopied ? <Check className="w-5 h-5" /> : <Copy className="w-5 h-5" />}
                          </button>
                        </div>
                      </div>
                      <div>
                        <p className="text-xs text-zinc-500 mb-1">Atas Nama</p>
                        <p className="font-bold">{activeInvoice.accountName}</p>
                      </div>
                    </div>
                  )}

                  <div className="mt-4 pt-4 border-t border-zinc-800">
                    <p className="text-xs text-zinc-500 mb-1">Total Pembayaran</p>
                    <div className="flex justify-between items-center">
                      <span className="font-black text-2xl text-green-400">{formatRupiah(activeInvoice.total)}</span>
                      <button onClick={() => copyToClipboard(activeInvoice.total.toString())} className="text-zinc-400 hover:text-white">
                        <Copy className="w-4 h-4" />
                      </button>
                    </div>
                    <p className="text-[10px] text-zinc-500 mt-1">Sertakan nominal hingga 3 digit terakhir.</p>
                  </div>
                </div>
              )}

              {/* Order Details Accordion */}
              <div className="bg-zinc-950 border border-zinc-800 rounded-2xl p-5">
                <h4 className="font-bold text-sm mb-4 text-white">Rincian Pesanan</h4>
                <div className="space-y-3 text-sm">
                  <div className="flex justify-between"><span className="text-zinc-500">Username</span><span className="font-semibold">{activeInvoice.username}</span></div>
                  <div className="flex justify-between"><span className="text-zinc-500">Item</span><span className="font-bold text-green-400">{activeInvoice.amount}</span></div>
                  <div className="flex justify-between"><span className="text-zinc-500">Harga Item</span><span>{formatRupiah(activeInvoice.price)}</span></div>
                  <div className="flex justify-between"><span className="text-zinc-500">Biaya Layanan</span><span>{formatRupiah(activeInvoice.fee)}</span></div>
                  <div className="flex justify-between"><span className="text-zinc-500">Tipe Pengiriman</span><span>{activeInvoice.methodType}</span></div>
                  <div className="flex justify-between"><span className="text-zinc-500">WhatsApp</span><span>{activeInvoice.whatsapp}</span></div>
                </div>
              </div>
            </div>

            {/* Footer Buttons */}
            <div className="p-5 border-t border-zinc-800 bg-zinc-950">
              {invoiceStatus === 'PENDING' ? (
                <div className="space-y-3">
                  <button 
                    onClick={simulatePayment}
                    className="w-full bg-green-500 hover:bg-green-400 text-black font-bold py-3.5 rounded-xl transition-all"
                  >
                    Selesaikan Pembayaran
                  </button>
                  <p className="text-xs text-center text-zinc-500">Dalam versi produksi, sistem akan mengecek mutasi otomatis.</p>
                </div>
              ) : invoiceStatus === 'FAILED' ? (
                <button 
                  onClick={() => {
                    setInvoiceModalOpen(false);
                    setUsername('');
                    setIsValidated(false);
                    setSelectedProduct(null);
                    setWhatsapp('');
                  }}
                  className="w-full bg-zinc-800 hover:bg-zinc-700 text-white font-bold py-3.5 rounded-xl transition-all border border-zinc-700"
                >
                  Tutup & Kembali
                </button>
              ) : (
                <button disabled className="w-full bg-zinc-800 text-zinc-500 font-bold py-3.5 rounded-xl cursor-not-allowed border border-zinc-700 flex items-center justify-center gap-2">
                  <RefreshCw className="w-4 h-4 animate-spin" /> Mohon Tunggu...
                </button>
              )}
            </div>
          </div>
        </div>
      )}

      {/* Tailwind Utility style */}
      <style dangerouslySetInnerHTML={{__html: `
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #3f3f46; border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #52525b; }
        
        @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
        .animate-fade-in { animation: fade-in 0.3s ease-out forwards; }
        
        @keyframes slide-up { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        .animate-slide-up { animation: slide-up 0.4s ease-out forwards; }
        
        @keyframes scale-in { from { opacity: 0; transform: scale(0.95); transform-origin: bottom right; } to { opacity: 1; transform: scale(1); transform-origin: bottom right; } }
        .animate-scale-in { animation: scale-in 0.2s ease-out forwards; }
      `}} />
    </div>
  );
}
