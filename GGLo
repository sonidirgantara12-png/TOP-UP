    setInvoiceStatus('PAID');
    
    setTimeout(() => {
      setInvoiceStatus('PROCESSING');
      
      setTimeout(() => {
        setInvoiceStatus('FAILED'); // Diubah menjadi FAILED (Gagal)
        
        const failedTx = {
          id: activeInvoice.id,
          username: activeInvoice.username,
          amount: activeInvoice.amount,
          price: activeInvoice.total,
          status: 'GAGAL',
          date: 'Barusan',
          payment: activeInvoice.payment
        };
        setSimulatedTransactions(prev => [failedTx, ...prev]);
      }, 3500); 
    }, 2000); 
  };

  const handleSearchTransaction = (e) => {
    e.preventDefault();
    if (!searchInvoice.trim()) return;

    const query = searchInvoice.trim().toUpperCase();
    const found = simulatedTransactions.find(tx => tx.id.toUpperCase() === query) 
                  || (activeInvoice && activeInvoice.id.toUpperCase() === query ? {
                      id: activeInvoice.id,
                      username: activeInvoice.username,
                      amount: activeInvoice.amount,
                      price: activeInvoice.total,
                      status: invoiceStatus === 'FAILED' ? 'GAGAL' : (invoiceStatus === 'PENDING' ? 'PENDING' : 'PROCESSING'),
                      date: 'Hari ini',
                      payment: activeInvoice.payment
