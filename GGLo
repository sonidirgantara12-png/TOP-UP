    e.preventDefault();
    if (!username.trim()) return;
    
    setIsValidating(true);
    setIsValidated(false);
    
    setTimeout(() => {
      setIsValidating(false);
      setIsValidated(true);
      setFormErrors(prev => ({...prev, username: null}));
    }, 1200);
