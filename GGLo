    const seed = name || 'Rubox';
    let hash = 0;
    for (let i = 0; i < seed.length; i++) {
      hash = seed.charCodeAt(i) + ((hash << 5) - hash);
    }
    const colorH = Math.abs(hash % 360);
    const bgGradient = `linear-gradient(135deg, hsl(${colorH}, 70%, 40%), hsl(${(colorH + 120) % 360}, 80%, 25%))`;
    
    return (
      <div className="w-14 h-14 rounded-full flex items-center justify-center font-bold text-white text-xl relative shadow-md" style={{ background: bgGradient }}>
