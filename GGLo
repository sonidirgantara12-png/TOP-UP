    setIsValidated(true);
    setFormErrors(prev => ({...prev, username: null}));
  };

  const scrollToSection = (id) => {
    const el = document.getElementById(id);
    if (el) {
        const y = el.getBoundingClientRect().top + window.scrollY - 100;
        window.scrollTo({ top: y, behavior: 'smooth' });
    }
  };

  const copyToClipboard = (text) => {
    const textarea = document.createElement("textarea");
    textarea.value = text;
    document.body.appendChild(textarea);
    textarea.select();
    try {
      document.execCommand("copy");
      setIsCopied(true);
      setTimeout(() => setIsCopied(false), 2000);
    } catch (err) {
      console.error("Failed to copy", err);
    }
    document.body.removeChild(textarea);
  };

  const handleCheckout = () => {
    const errors = {};
    if (!username.trim()) errors.username = "Username Roblox wajib diisi!";
    if (username.trim() && !isValidated) errors.username = "Silakan klik verifikasi username Anda terlebih dahulu!";
    if (!selectedProduct) errors.product = "Pilih paket RUBOX yang Anda inginkan!";
    if (!selectedPayment) errors.payment = "Pilih salah satu metode pembayaran!";
    if (!whatsapp.trim()) {
      errors.whatsapp = "Nomor WhatsApp wajib diisi!";
    } else if (!/^[0-9+]{8,15}$/.test(whatsapp)) {
      errors.whatsapp = "Nomor WhatsApp tidak valid!";
    }

    if (Object.keys(errors).length > 0) {
      setFormErrors(errors);
      if (errors.username) scrollToSection('username-input-section');
      else if (errors.product) scrollToSection('catalog-section');
      else if (errors.payment) scrollToSection('payment-section');
      return;
